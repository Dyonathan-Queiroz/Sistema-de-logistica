# =============================================================
#  CONFIGURAÇÃO DO AMBIENTE — Sistema Logístico
# =============================================================
#
#  Como usar:
#    1. Copie este arquivo:  cp .env.example .env
#    2. Preencha os valores reais no .env
#    3. NUNCA comite o arquivo .env no git (já está no .gitignore)
#
# =============================================================

# URL de conexão com o banco de dados MySQL
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=mysql+pymysql://root:SUA_SENHA_AQUI@localhost:3306/sistema_logistico

# Chave secreta da aplicação (usada para segurança de sessões/tokens)
# Para gerar uma chave segura, execute no terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque_por_uma_chave_aleatoria_segura_antes_de_producao
